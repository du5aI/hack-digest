BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Интервал по умолчанию для новых подписчиков: 12h, 3d, 1w...
DEFAULT_INTERVAL=7d
# Источники по умолчанию: devpost, codenrock
DEFAULT_SOURCES=devpost,codenrock
# Сколько хакатонов показывать из каждого источника
PER_SOURCE=10
DB_PATH=/data/hackdigest.db
