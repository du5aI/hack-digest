BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Интервал по умолчанию для новых подписчиков: 12h, 3d, 1w...
DEFAULT_INTERVAL=7d
# Источники по умолчанию (все): hackathons_rus,codenrock,leader_id,devpost,mlh,devfolio,telegram
# DEFAULT_SOURCES=hackathons_rus,codenrock,leader_id,telegram
# Каналы по умолчанию (через запятую); если не задано — встроенный список вузов, компаний и агрегаторов
# DEFAULT_CHANNELS=hackathonsrus,codenrock,fcs_hse
# Сколько событий показывать в каждой секции дайджеста
SECTION_LIMIT=10
DB_PATH=/data/hackdigest.db
